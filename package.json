{
  "name": "work-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:full": "concurrently -k \"python backend/run_offline.py\" \"vite --host 127.0.0.1 --port 8082 --strictPort\"",
    "dev:connected": "concurrently -k \"python backend/run_connected.py\" \"vite --host 127.0.0.1 --port 8082 --strictPort\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.5",
    "typescript": "7.0.2"
  }
}
